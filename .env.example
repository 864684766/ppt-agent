# 应用监听地址；默认 127.0.0.1，仅本机可访问。由 python main.py 启动时使用。
# 所有已接线配置：系统环境变量优先于根目录 .env，缺失时使用 Settings 默认值。
APP_HOST=127.0.0.1
# 监听端口，默认 8000，范围 1–65535；直接运行 uvicorn 时请另传 --port。
APP_PORT=8000

# OpenAI 兼容代理基础地址；无默认地址，留空时对话接口返回 503。
# 填代理要求的完整基础路径（通常含 /v1 或供应商指定路径），不要加 /chat/completions。
LLM_BASE_URL=
# 在本机 .env 填写真实密钥，不提交、不写进文档；留空时对话接口返回 503。
LLM_API_KEY=
# 默认模型名称，须与代理支持的名称一致；普通对话调试接口使用它，留空返回 503。
LLM_MODEL=
# 单次模型请求超时秒数；默认 60，有效范围 >0 且 <=600，适用于当前 LangChain 对话。
# 流开始后超时发送 error 事件（model_timeout）；当前不自动重试，不是整个流的总时间上限。
LLM_TIMEOUT_SECONDS=60
# 最大输出 token 数；默认 1024，范围 1–32768，仍须符合实际模型限制。
# 适用于当前普通对话，不控制输入长度，也不保证推理模型一定能在此额度内输出正文。
LLM_MAX_TOKENS=1024

# 以下任务专用模型已实现配置选择，业务调用尚未接线。任务专用值优先于 LLM_MODEL。
# 大纲生成及编辑模型；留空回退默认模型，当前 /debug/chat 不使用本项。
LLM_OUTLINE_MODEL=
# LangChain 模板识别模型；留空回退默认模型，模型名不代表支持视觉输入。
LLM_TEMPLATE_ANALYSIS_MODEL=
# Harness 模板使用及生成模型；留空回退默认模型，Harness 接入尚未实现。
LLM_PPT_GENERATION_MODEL=

# 以下 LangSmith 配置尚未由 Settings 读取并初始化；写进 .env 不会自动导出至进程环境。
# 追踪开关，建议默认 false；LangChain SDK 可能读取外部系统环境中的追踪配置。
LANGSMITH_TRACING=false
# 平台端点，示例为美国区域；后续初始化时使用，按实际工作区区域填写。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 仅在本机 .env 填写 LangSmith 密钥；当前项目的 .env 追踪接线尚未实现。
LANGSMITH_API_KEY=
# Agent 标识须匹配控制台实际 ID；此处仅为示例，尚未接线，不与旧 PROJECT 变量混用。
LANGSMITH_AGENT_ID=ppt-agent
# 追踪环境分类，示例 local；也可按平台使用 development/staging/production，尚未接线。
LANGSMITH_AGENT_ENVIRONMENT=local

# SearXNG服务根地址（不加/search），无默认地址；留空不能执行真实搜索。
# 示例：http://127.0.0.1:8082；在本机.env填写实际地址，无需server.secret_key。
# 以下配置由真实搜索调试入口读取；尚未接HTTP路由或聊天模型工具循环。
# 系统环境变量优先于.env，未设置时使用Settings默认值。
SEARXNG_BASE_URL=
# 普通网页引擎name，英文逗号分隔；默认sogou，留空使用服务器默认配置。
# 例如sogou,360search；仅填写服务器已启用且确认可用的普通网页引擎。
SEARXNG_DEFAULT_ENGINES=sogou
# Agent单次调用可以明确选择的普通网页引擎范围；提示词将根据此列表生成说明，
# 工具运行时也应校验传入值；提示词生成和工具参数校验尚未接线。
# 默认sogou,bing,360search；留空解析为空列表，不表示全部允许，不应留空。
# 它不是服务器引擎自动发现结果，必须与settings.yml的name一致。
# 例如sogou,bing,360search；不要放入图片、视频引擎，也不要填写服务器地址。
SEARXNG_ALLOWED_ENGINES=sogou,bing,360search
# HTTP各阶段等待超时秒数，默认30，范围>0且<=120；不是任务总时限。
WEB_SEARCH_TIMEOUT_SECONDS=30

# fetch_webpage读取目标网页的HTTP各阶段等待超时秒数；默认20，范围>0且<=120。
# 系统环境优先于.env；已接真实工具集成测试，不影响SearXNG搜索超时，不是任务总时限。
WEBPAGE_TIMEOUT_SECONDS=20
# 解压后HTML下载字节上限，默认2000000，范围1024至10000000；超限报错。
# 与工具max_chars（返回正文字符数）不同；缺失时使用默认值，不能留空。
WEBPAGE_MAX_DOWNLOAD_BYTES=2000000
# 网页HTTPS证书校验：默认true；false为兼容模式，允许证书异常的HTTPS站点。
# false会跳过所有目标网站的证书身份校验，不能确认服务端身份；不只针对某个域名。
# 已接网页工具测试的连接创建；不影响其他模块自行创建的连接。
# 系统环境优先于.env，缺失使用true，不能留空；不会绕过登录、验证码或访问限制。
WEBPAGE_TLS_VERIFY=true
