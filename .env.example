# 应用监听地址；默认 127.0.0.1，仅本机可访问。由 python main.py 启动时使用。
# 所有已接线配置：系统环境变量优先于根目录 .env，缺失时使用 Settings 默认值。
APP_HOST=127.0.0.1
# 监听端口，默认 8000，范围 1–65535；直接运行 uvicorn 时请另传 --port。
APP_PORT=8000

# 应用日志最低级别，默认INFO；可选DEBUG、INFO、WARNING、ERROR、CRITICAL，必须大写。
# 记录所选级别及更严重的日志，例如WARNING包含WARNING/ERROR/CRITICAL。
# 系统环境优先于.env，缺失使用INFO，不能留空；修改后重启服务或重跑测试。
# 已接服务、pytest统一入口与独立搜索示例；日志含请求/操作编号、耗时和安全错误位置。
# 应用DEBUG不启用httpx/httpcore/OpenAI/LangChain的DEBUG正文日志；不接管Uvicorn自己的级别。
LOG_LEVEL=INFO
# 应用日志输出目标，默认both；file仅文件、console仅控制台、both两者，必须小写。
# 文件按本地日期保存为log/ppt-agent-YYYY-MM-DD.log，同日追加，跨天自动切换。
# console使用标准错误stderr，不创建日志目录或文件；历史文件不自动删除。
# 系统环境优先于.env，缺失使用both，不能留空；修改后重启服务或重跑测试。
# 仅控制本项目添加的处理器；pytest/Uvicorn自带的日志输出仍由各自配置管理。
LOG_OUTPUT=both

# 单个上传文件实际字节上限；默认20 MiB=20971520字节，范围1024–104857600。
# 适用于POST /ppt-agent/v1/chat（message + 可选file/template_key）。系统环境优先于.env，缺失用默认值，不能留空。
# 解析前另检查整个multipart请求，允许最多64 KiB边界/字段开销；不是正文长度限制。
# 每次请求读取配置；框架可能使用系统临时文件，不提供长期原文件归档。
UPLOAD_MAX_FILE_BYTES=20971520
# DOCX/XLSX/PPTX所有ZIP条目累计解压字节上限；默认100 MiB，范围1024–1073741824。
# 声明大小与实际解压量均检查；另有固定5000条目及关键XML每份2 MiB限制。
# 仅影响以上Office格式上传检查，不是转换/渲染上限；系统环境优先于.env，缺失默认，不能留空。
UPLOAD_MAX_UNCOMPRESSED_BYTES=104857600

# 附件读取结果累计文字上限，按Python字符计数，不是文件字节；默认200000，范围1–2000000。
# 超限返回413，不悄悄截断；对话附件分支已接线，读取器由宿主注入此值。
# 系统环境优先于.env，缺失用默认值，不能留空；当前不会把结果发送给模型。
DOCUMENT_MAX_CHARACTERS=200000
# 单文件遍历单元上限，默认5000，范围1–20000；包括空段落、空行、页面及PPT形状。
# 不是最终非空blocks条数；超限返回413。系统环境优先于.env，缺失默认，不能留空。
DOCUMENT_MAX_BLOCKS=5000
# 单文件累计遍历单元格数上限，默认100000，范围1–1000000，包含空单元格。
# 作用于Word/PPT表格、Excel行；不是字符数。超限返回413。
# 系统环境优先于.env，缺失用默认值，不能留空。
DOCUMENT_MAX_CELLS=100000

# OpenAI 兼容代理基础地址；无默认地址，留空不影响当前对话文件解析；实际模型调用由独立模块/后续Agent组装时检查。
# 填代理要求的完整基础路径（通常含 /v1 或供应商指定路径），不要加 /chat/completions。
LLM_BASE_URL=
# 在本机 .env 填写真实密钥，不提交、不写进文档；留空不影响当前对话文件解析；实际模型调用由独立模块/后续Agent组装时检查。
LLM_API_KEY=
# 默认模型名称，须与代理支持的名称一致；供独立模型模块或后续Agent使用；当前对话入口不调用模型，留空不影响文件解析。
LLM_MODEL=
# 单次模型请求超时秒数；默认 60，有效范围 >0 且 <=600，适用于当前 LangChain 对话。
# 流开始后超时发送 error 事件（model_timeout）；当前不自动重试，不是整个流的总时间上限。
LLM_TIMEOUT_SECONDS=60
# 最大输出 token 数；默认 1024，范围 1–32768，仍须符合实际模型限制。
# 适用于独立模型模块/后续Agent，不控制输入长度；当前对话只做文件解析，不使用此配置。
LLM_MAX_TOKENS=1024

# 以下任务专用模型已实现配置选择，业务调用尚未接线。任务专用值优先于 LLM_MODEL。
# 大纲生成及编辑模型；留空回退默认模型，当前 /debug/chat 不使用本项。
LLM_OUTLINE_MODEL=
# LangChain 模板识别模型；留空回退默认模型，模型名不代表支持视觉输入。
LLM_TEMPLATE_ANALYSIS_MODEL=
# 图片理解模型，默认glm-5.3-flash；当前由tests.test_template_vision真实图片测试使用。
# 沿用LLM_BASE_URL/LLM_API_KEY，不改默认文本模型或其他任务模型。
# 系统环境优先于.env，缺失使用glm-5.3-flash，不能留空；模型和代理需支持图片输入。
# 尚未接入Harness或正式模板分析流程，本项填写不代表已完成视觉质量验收。
LLM_VISION_MODEL=glm-5.3-flash
# Harness 模板使用及生成模型；留空回退默认模型，Harness 接入尚未实现。
LLM_PPT_GENERATION_MODEL=

# Gotenberg文档转换服务根地址，不加/forms/libreoffice/convert或/health。
# 无默认地址，缺失或留空表示未配置；在本机.env填写实际HTTP(S)地址。
# 示例：http://127.0.0.1:8083；系统环境变量优先于.env，外层组装时读取。
# 已接tests/test_gotenberg_converter.py真实PPTX转PDF测试；服务启动不自动转换。
# 尚未接HTTP上传、Agent或PDF页面图片生成。
GOTENBERG_BASE_URL=
# 转换HTTP各阶段等待超时（秒），默认120，范围>0且<=600，缺失取默认值，不能留空。
# 系统环境优先于.env；仅控制本项目客户端，不覆盖Gotenberg服务端API超时或排队限制。
GOTENBERG_TIMEOUT_SECONDS=120

# 以下 LangSmith 配置尚未由 Settings 读取并初始化；写进 .env 不会自动导出至进程环境。
# 追踪开关，建议默认 false；LangChain SDK 可能读取外部系统环境中的追踪配置。
LANGSMITH_TRACING=false
# 平台端点，示例为美国区域；后续初始化时使用，按实际工作区区域填写。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 仅在本机 .env 填写 LangSmith 密钥；当前项目的 .env 追踪接线尚未实现。
LANGSMITH_API_KEY=
# Agent 标识须匹配控制台实际 ID；此处仅为示例，尚未接线，不与旧 PROJECT 变量混用。
LANGSMITH_AGENT_ID=ppt-agent
# 追踪环境分类，示例 local；也可按平台使用 development/staging/production，尚未接线。
LANGSMITH_AGENT_ENVIRONMENT=local

# SearXNG服务根地址（不加/search），无默认地址；留空不能执行真实搜索。
# 示例：http://127.0.0.1:8082；在本机.env填写实际地址，无需server.secret_key。
# 以下配置由真实搜索调试入口读取；尚未接HTTP路由或聊天模型工具循环。
# 系统环境变量优先于.env，未设置时使用Settings默认值。
SEARXNG_BASE_URL=
# 普通网页引擎name，英文逗号分隔；默认sogou，留空使用服务器默认配置。
# 例如sogou,360search；仅填写服务器已启用且确认可用的普通网页引擎。
SEARXNG_DEFAULT_ENGINES=sogou
# Agent单次调用可以明确选择的普通网页引擎范围；提示词将根据此列表生成说明，
# 工具运行时也应校验传入值；提示词生成和工具参数校验尚未接线。
# 默认sogou,bing,360search；留空解析为空列表，不表示全部允许，不应留空。
# 它不是服务器引擎自动发现结果，必须与settings.yml的name一致。
# 例如sogou,bing,360search；不要放入图片、视频引擎，也不要填写服务器地址。
SEARXNG_ALLOWED_ENGINES=sogou,bing,360search
# HTTP各阶段等待超时秒数，默认30，范围>0且<=120；不是任务总时限。
WEB_SEARCH_TIMEOUT_SECONDS=30

# fetch_webpage读取目标网页的HTTP各阶段等待超时秒数；默认20，范围>0且<=120。
# 系统环境优先于.env；已接真实工具集成测试，不影响SearXNG搜索超时，不是任务总时限。
WEBPAGE_TIMEOUT_SECONDS=20
# 解压后HTML下载字节上限，默认2000000，范围1024至10000000；超限报错。
# 与工具max_chars（返回正文字符数）不同；缺失时使用默认值，不能留空。
WEBPAGE_MAX_DOWNLOAD_BYTES=2000000
# 网页HTTPS证书校验：默认true；false为兼容模式，允许证书异常的HTTPS站点。
# false会跳过所有目标网站的证书身份校验，不能确认服务端身份；不只针对某个域名。
# 已接网页工具测试的连接创建；不影响其他模块自行创建的连接。
# 系统环境优先于.env，缺失使用true，不能留空；不会绕过登录、验证码或访问限制。
WEBPAGE_TLS_VERIFY=true

# RustFS/S3兼容API根地址，不是8084管理控制台；无默认，空值时模板列表返回503。
# 本机.env填写用户提供的http://124.71.135.104:8081，不能包含桶路径或查询参数。
# 以下配置用于GET /ppt-agent/v1/templates，以及POST /chat指定template_key时的下载；系统环境优先于.env，缺失使用Settings默认。
S3_ENDPOINT_URL=
# 模板桶名，默认ppts，3–63字符、小写S3桶名称；不能留空。
S3_TEMPLATE_BUCKET=ppts
# RustFS Access Key ID与Secret，成对填写到本机.env，不提交、不传前端。
# 两者均空使用匿名模式（当前服务器匿名ListBucket为403）；不读取AWS默认凭据链。
# 列表需要ppts桶s3:ListBucket权限，chat读取选中模板另需该对象的s3:GetObject权限。
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3签名区域，默认us-east-1，不能留空；按RustFS服务端实际配置填写。
S3_REGION=us-east-1
# S3连接/读取各阶段超时秒数，默认20，范围>0且<=120，不能留空。
# 不自动重试；不是整体任务超时。取消等待不保证立即终止底层线程。
S3_TIMEOUT_SECONDS=20

# chat读取OSS模板的原文件字节上限，默认50 MiB=52428800，范围1024–209715200。
# 与UPLOAD_MAX_FILE_BYTES（本机参考附件上传）分开；不设置时用默认值，不能留空。
# 系统环境优先于.env；已接OSS下载声明/实际字节检查及后续PPTX校验。
# Office累计展开大小、DOCUMENT_MAX_*仍独立生效；超限明确失败，不返回截断模板。
S3_TEMPLATE_MAX_FILE_BYTES=52428800
